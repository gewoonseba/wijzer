# Vercel AI Gateway — required for clip creation (agent summarization)
# Create at: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Clip storage: file (default) or convex
# CLIP_STORE=convex
# NEXT_PUBLIC_CONVEX_URL=   # browser + ConvexReactClient (from `npx convex dev`)
# CONVEX_URL=               # server / ConvexHttpClient (often same as above)

# Optional: override clip storage directory when CLIP_STORE=file (default: .data/clips.json)
# WIJZER_CLIP_STORE_PATH=

# Test / CI: canned clip only — no remote fetch, no AI (scripts/with-dev-server.mjs defaults this on)
# WIJZER_MOCK_CLIP=1
